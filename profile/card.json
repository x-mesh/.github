        ],
        "compact": true
      },
      {
        "id": "x-backup",
        "layer": "operations",
        "at": [
          1.26,
          1.55
        ],
        "compact": true
      }
    ],
    "edges": [
      {
        "from": "term-mesh",
        "to": "xm",
        "kind": "contract",
        "label": "telemetry contract",
        "bidir": true
      },
      {
        "from": "gk",
        "to": "xm",
        "kind": "contract",
        "label": "finish --gate"
      },
      {
        "from": "xm",
        "to": "mem-mesh",
        "kind": "contract",
        "label": "handoff mirror"
      },
      {
        "from": "term-mesh",
        "to": "mem-mesh",
        "kind": "optin",
        "label": "opt-in"
      },
      {
        "from": "aic",
