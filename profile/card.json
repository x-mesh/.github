{
  "org": "x-mesh",
  "title": "x-mesh: tools",
  "command": "xm layers",
  "footer": {
    "lead": "use each tool on its own.",
    "dim": "integrate them when needed."
  },
  "exclude": [
    "x-kit",
    ".github"
  ],
  "layers": [
    {
      "id": "environment",
      "color": "cyan",
      "hex": "#0969da",
      "repos": [
        "term-mesh"
      ],
      "owns": "run agents locally or over SSH",
      "wired": "term-mesh ⇄ xm   contract in code",
      "lead": "Runs agents.",
      "body": "Runs multiple agents in isolated worktrees, locally or over SSH."
    },
    {
      "id": "harness",
      "color": "purple",
      "hex": "#8250df",
      "repos": [
        "xm"
      ],
      "owns": "plan and review repository changes",
      "wired": "gk → xm          finish --gate",
      "lead": "Plans and reviews changes.",
      "body": "Builds repository-grounded plans, keeps changes small, and uses multiple models to review the result."
    },
    {
      "id": "context",
      "color": "green",
      "hex": "#1a7f37",
      "repos": [
        "mem-mesh",
        "output-mesh"
      ],
      "tag": "(opt-in)",
      "owns": "store work state and agent outputs",
      "wired": "configured per agent",
      "wiredColor": "green",
      "lead": "Stores context and outputs.",
      "body": "mem-mesh stores decisions and resumable work state. output-mesh records agent artifacts and their source sessions. Both are optional and read-only.",
      "rail": true
    },
    {
      "id": "version control",
      "color": "orange",
      "hex": "#bc4c00",
      "repos": [
        "gk"
      ],
      "owns": "make Git operations reversible",
      "measure": {
        "kind": "fileInRepos",
        "path": ".gk.yaml",
        "template": "runs under {hit} of the {total} repos here"
      },
      "lead": "Makes Git operations reversible.",
      "body": "Provides reflog-based undo, snapshot restore, and repository policies.",
      "rail": true
    },
    {
      "id": "operations",
      "color": "dim",
      "hex": "#57606a",
      "repos": [
        "aic",
        "edc",
        "httprove",
        "dbops",
        "x-backup"
      ],
      "owns": "diagnose production problems",
      "wired": "standalone · none calls another",
      "lead": "Diagnoses production problems.",
      "body": "Checks shell, system, network, HTTP, database, and backup problems. Diagnostic actions are read-only by default."
    }
  ],
  "diagram": {
    "cell": [
      491,
      230
    ],
    "node": [
      330,
      96
    ],
    "pad": 44,
    "nodes": [
      {
        "id": "term-mesh",
        "layer": "environment",
        "at": [
          0,
          0
        ],
        "tag": "ENVIRONMENT",
        "sub": "where agents run"
      },
      {
        "id": "xm",
        "layer": "harness",
        "at": [
          1,
          0
        ],
        "tag": "HARNESS",
        "sub": "plan · gate · review"
      },
      {
        "id": "gk",
        "layer": "version control",
        "at": [
          2,
          0
        ],
        "tag": "VERSION CONTROL",
        "sub": "policies · undo"
      },
      {
        "id": "aic",
        "layer": "operations",
        "at": [
          0,
          1
        ],
        "tag": "OPERATIONS",
        "sub": "shell + SRE agent"
      },
      {
        "id": "mem-mesh",
        "layer": "context",
        "at": [
          1,
          1
        ],
        "tag": "CONTEXT",
        "sub": "mem-mesh · output-mesh",
        "style": "optional"
      },
      {
        "id": "edc",
        "layer": "operations",
        "at": [
          0,
          1.55
        ],
        "compact": true
      },
      {
        "id": "httprove",
        "layer": "operations",
        "at": [
          0.42,
